{
  "name": "stackr",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@stackr/web",
    "dev:web": "turbo run dev --filter=@stackr/web",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "turbo run test:e2e --filter=@stackr/web",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "test:e2e:mobile": "maestro test apps/mobile/.maestro"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@stackr/eslint-config": "workspace:*",
    "@stackr/prettier-config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "vitest": "^3.2.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css}": [
      "prettier --write"
    ],
    "!(AGENTS).md": [
      "prettier --write"
    ]
  }
}
