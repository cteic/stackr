{
  "name": "stackr",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@stackr/web",
    "dev:web": "turbo run dev --filter=@stackr/web",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "turbo run test:e2e --filter=@stackr/web",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "test:e2e:mobile": "maestro test apps/mobile/.maestro"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@stackr/eslint-config": "workspace:*",
    "@stackr/prettier-config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "vitest": "^3.2.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css}": [
      "prettier --write"
    ],
    "!(AGENTS).md": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "^1.11.0",
      "node-forge": "^1.4.1",
      "flatted": "^3.4.2",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=6.0.0 <6.2.4": "6.2.4",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "hono@<4.12.25": ">=4.12.25",
      "tar": "^7.5.19",
      "@xmldom/xmldom": "^0.9.12",
      "fast-uri": "^4.1.4",
      "postcss": "^8.5.18",
      "axios": "^1.20.0",
      "js-yaml": ">=4.3.2 <5.0.0",
      "sharp": "^0.35.5",
      "socket.io-parser": "^4.2.7",
      "browserslist": "^4.28.7",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@2": "^2.1.6",
      "brace-expansion@5": "^5.0.11",
      "nanoid@3": "^3.3.18",
      "bitcoinjs-lib@6": "^6.1.8",
      "compression": "^1.8.2",
      "dompurify": "^3.4.17",
      "follow-redirects": "^1.16.1",
      "source-map-js": "^1.2.2",
      "undici@6": "^6.28.1",
      "zod@4": "^4.6.6",
      "decode-uri-component": "^0.5.1",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4"
    },
    "auditConfig": {
      "//": "Baseline allowlist for the CI `pnpm audit --prod --audit-level high` gate. Each entry is a high/critical advisory with NO fix reachable from our direct deps without a major/minor upgrade (deferred to per-package PRs under #69). The gate fails the build on any NEW high/critical so the baseline can't grow silently. Burn this list down as upgrades land; never add to it to silence a fixable advisory.",
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    },
    "packageExtensions": {
      "next": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "next-themes": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "tamagui": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "@tamagui/core": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "@tamagui/web": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      }
    },
    "patchedDependencies": {
      "query-string@7.1.3": "patches/query-string@7.1.3.patch"
    }
  }
}
