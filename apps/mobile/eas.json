{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "<<APPLE_ID>>",
        "ascAppId": "<<ASC_APP_ID>>",
        "appleTeamId": "<<APPLE_TEAM_ID>>"
      },
      "android": {
        "serviceAccountKeyPath": "<<GOOGLE_SERVICE_ACCOUNT_KEY_PATH>>",
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    }
  }
}
