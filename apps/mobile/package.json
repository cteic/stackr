{
  "name": "@stackr/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "export:check": "expo export --platform ios --output-dir .expo-export",
    "assets": "node scripts/generate-brand-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf .expo .expo-export node_modules"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@ethersproject/shims": "^5.8.0",
    "@privy-io/expo": "0.70.0",
    "@privy-io/expo-native-extensions": "0.0.12",
    "@stackr/features": "workspace:*",
    "@stackr/models": "workspace:*",
    "@stackr/services": "workspace:*",
    "@stackr/signer": "workspace:*",
    "@stackr/wallet-link": "workspace:*",
    "@stackr/wallet-ui": "workspace:*",
    "@supabase/supabase-js": "^2.110.0",
    "@tamagui/animations-react-native": "2.0.0-rc.42",
    "@tanstack/react-query": "^5.62.8",
    "buffer": "^6.0.3",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-application": "~6.0.2",
    "expo-camera": "~16.0.18",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-local-authentication": "~15.0.2",
    "expo-router": "~4.0.0",
    "expo-screen-capture": "~7.0.1",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.2",
    "fast-text-encoding": "^1.0.6",
    "permissionless": "^0.2.47",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-get-random-values": "^1.11.0",
    "react-native-passkeys": "^0.4.0",
    "react-native-qrcode-styled": "0.3.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-webview": "13.12.5",
    "tamagui": "2.0.0-rc.42",
    "viem": "2.52.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
