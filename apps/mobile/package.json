  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@stackr/eslint-config": "workspace:*",
    "@stackr/prettier-config": "workspace:*",
    "@stackr/tsconfig-config": "workspace:*",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
