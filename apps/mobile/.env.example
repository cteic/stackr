# Template for a local `.env.development` or `.env.production`. Copy it, fill
# it in, and never commit a filled-in `.env.production`. Git ignores that
# filename for exactly this reason.
#
# Which file Expo reads depends on the build mode, not on a flag you pass:
#
#   expo start / --profile development  ->  .env.development
#   eas build --profile production      ->  EAS environment variables
#                                           (plus .env.production if present
#                                           locally, for `expo export`)
#
# Production values live in EAS, in the `production` environment. Create them
# once with:
#
#   eas env:create --environment production \
#     --name EXPO_PUBLIC_PRIVY_APP_ID --value <id> --visibility plaintext
#
# Use `plaintext` visibility, not `secret`: every `EXPO_PUBLIC_*` value is
# inlined into the JavaScript bundle at build time and is readable by anyone
# who downloads the app. Marking one `secret` hides it from the dashboard
# without hiding it from users, which is worse than not hiding it at all. No
# value in this file is a secret; a real secret belongs in a server route, not
# in the app.

# Privy app credentials. Create an app at https://dashboard.privy.io, enable
# Email login and embedded wallets for Ethereum and Solana, then add the bundle
# id ie.stackr.wallet and the stackr:// scheme to the allowed list.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Stackr Link relay. The project URL and the publishable (anon) key of the
# Supabase project that carries pairing traffic between stackr.ie and the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
