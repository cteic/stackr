# Development build configuration. Expo loads this file only when the build
# runs in development mode (`expo start`, `eas build --profile development`);
# a production build never reads it, so nothing here can leak into a store
# binary. Production values come from EAS environment variables instead: see
# README.md, "Environment separation".
#
# Every value here is a public identifier that ships in the app bundle by
# design. The trust boundary is the dashboard configuration behind each id
# (allowed bundle ids, login methods, row-level security), not secrecy.
#
# KNOWN GAP: these ids point at the same Privy app and Supabase project that
# production uses, so local development currently reads and writes production
# data. Separating them means creating a second Privy app and a second Supabase
# project, which is an account action, not a code change. Until that happens,
# treat local pairing and login as production traffic.

# Privy app credentials. The client is bound to the ie.stackr.wallet bundle id
# and the stackr scheme in the Privy dashboard.
EXPO_PUBLIC_PRIVY_APP_ID=cmr4vy9sn009d0cjs2i6tht7y
EXPO_PUBLIC_PRIVY_CLIENT_ID=client-WY6b8ob5nrD3Wp3QCqCuAxpFx5Wbudz58pn6Eqw6L4DVJ

# Stackr Link relay: the same public pair the web app ships. Link traffic is
# end-to-end encrypted before it reaches the relay.
EXPO_PUBLIC_SUPABASE_URL=https://wfcwtbiesgmbpfkbumbc.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_D9eVjUjJRRt8KU36fB5utw_qKe3AeNo
